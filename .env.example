# Optional: defaults to data/mosa.db
DATABASE_URL=data/mosa.db
# Optional: 64 hex characters; if absent a local key is generated in data/.encryption-key
APP_ENCRYPTION_KEY=
# Optional: set a unique owner password (at least 16 characters) to protect the app.
# Without this setting, Mosa remains available only on localhost.
MOSA_ADMIN_PASSWORD=
# Optional: canonical reachable HTTPS origin for one-use device invitations.
# Requires MOSA_ADMIN_PASSWORD and a trusted HTTPS reverse proxy to 127.0.0.1:3000.
# Do not set this to a provider URL or to a plain-HTTP address.
MOSA_PUBLIC_ORIGIN=
